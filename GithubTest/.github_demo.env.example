# GitHub Activity Demo - Environment Configuration
#
# Copy this file to .github_demo.env and customize for your setup.
# IMPORTANT: .github_demo.env should NOT be committed to the repository.
# It is in .gitignore to protect your credentials.
#
# This file is sourced by launch_demo.sh before executing the Python script.

# Git Author Configuration
# These values will be used as the committer for generated commits
export GIT_AUTHOR_NAME="Demo Bot"
export GIT_AUTHOR_EMAIL="your.email@example.com"

# Optional: Customize these if not set in launch_demo.sh
# export GITHUB_DEMO_REPO="${HOME}/github-demo-repo"
# export GIT_AUTHOR_NAME="Your School Name"

# Optional: If using GitHub Personal Access Token (not recommended, use SSH instead)
# export GITHUB_TOKEN="ghp_your_token_here"

# Note: For SSH authentication, ensure your SSH key is:
#   1. Generated: ssh-keygen -t ed25519 -C "your.email@example.com"
#   2. Added to GitHub: https://github.com/settings/keys
#   3. Loaded in agent: ssh-add ~/.ssh/id_ed25519
#   4. Remote URL set to SSH: git remote set-url origin git@github.com:username/repo.git
