<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.demo.github_activity</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__LAUNCH_SCRIPT_PATH__</string>
    </array>

    <key>StartInterval</key>
    <integer>86400</integer>

    <key>StandardOutPath</key>
    <string>__REPO_PATH__/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO_PATH__/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Label</key>
    <string>com.demo.github_activity</string>
</dict>
</plist>
